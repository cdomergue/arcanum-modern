// Included inside CampaignEditor; resource groups commit as one undo operation.
    using Messages=std::map<unsigned,std::string>;
    Messages messages(const std::string& path) const {Messages out;for(auto m:worlded::read_messages(read(path)))out[m.id]=m.text;return out;}
    static worlded::Bytes messageBytes(const Messages& entries){std::string out;for(const auto& [id,value]:entries){if(value.find_first_of("{}")!=std::string::npos)throw std::runtime_error("Text cannot contain braces");out+="{"+std::to_string(id)+"}{"+value+"}\r\n";}return worlded::Bytes(out.begin(),out.end());}
    void applyResources(std::map<std::string,worlded::Bytes> updates){for(auto it=updates.begin();it!=updates.end();)if(it->second==read(it->first))it=updates.erase(it);else ++it;if(updates.empty())return;undo.push_back({changes});redo.clear();for(auto& [name,data]:updates){validatePath(name);if(!references.count(name))references[name]=hash(installation.contains(name)?installation.read(name):worlded::Bytes{});changes[name]=std::move(data);}refresh();}
    void chooseCampaignForm(){bool ok;auto choice=QInputDialog::getItem(this,"Campaign definitions","What would you like to edit?",{"Quest and journals","World area","Encounter group","Encounter region"},0,false,&ok);if(!ok)return;if(choice=="Quest and journals")editQuest();else if(choice=="World area")editArea();else if(choice=="Encounter group")editEncounter();else editEncounterRegion();}
    static std::vector<int> questValues(const std::string& text){auto parts=QString::fromStdString(text).split(QRegularExpression("\\s+"),Qt::SkipEmptyParts);if(parts.size()!=23)throw std::runtime_error("A quest definition must contain exactly 23 integers");std::vector<int> values;for(auto part:parts){bool ok;int value=part.toInt(&ok);if(!ok)throw std::runtime_error("Invalid integer in quest definition");values.push_back(value);}if(values[0]<1 || values[0]>100)throw std::runtime_error("Quest experience level must be between 1 and 100");for(unsigned i=2;i<values.size();i++)if(values[i]<-1)throw std::runtime_error("Dialogue entry points must be -1 or nonnegative");return values;}
    void editQuest(){auto definitions=messages("rules/gamequest.mes"),normal=messages("mes/gamequestlog.mes"),dumb=messages("mes/gamequestlogdumb.mes");bool ok;int id=QInputDialog::getInt(this,"Quest","Existing or new quest ID",1000,1000,1999,1,&ok);if(!ok)return;std::vector<int> values(23,-1);values[0]=1;values[1]=0;if(definitions.count(id))values=questValues(definitions[id]);QDialog dialog(this);dialog.setWindowTitle(QString("Quest %1").arg(id));dialog.resize(850,740);QVBoxLayout layout(&dialog);QFormLayout form;QSpinBox level,alignment;level.setRange(1,100);level.setValue(values[0]);alignment.setRange(-100,100);alignment.setValue(values[1]);form.addRow("Experience level",&level);form.addRow("Alignment adjustment",&alignment);layout.addLayout(&form);QTableWidget table(7,3);table.setHorizontalHeaderLabels({"Normal dialogue","Bad reaction","Low intelligence"});table.setVerticalHeaderLabels({"Unknown","Mentioned","Accepted","Achieved","Completed","Other completed","Botched"});table.horizontalHeader()->setSectionResizeMode(QHeaderView::Stretch);for(int bank=0;bank<3;bank++)for(int row=0;row<7;row++)table.setItem(row,bank,new QTableWidgetItem(QString::number(values[2+bank*7+row])));layout.addWidget(&table);QPlainTextEdit journal,lowJournal;journal.setPlainText(QString::fromStdString(worlded::cp1252_utf8(normal[id])));lowJournal.setPlainText(QString::fromStdString(worlded::cp1252_utf8(dumb[id])));layout.addWidget(new QLabel("Journal text"));layout.addWidget(&journal);layout.addWidget(new QLabel("Low-intelligence journal text"));layout.addWidget(&lowJournal);QLabel hint("Dialogue numbers are entry lines in the NPC's dialogue. -1 suppresses that state. Scripts still control quest progress; this form does not change any saved quest state.");hint.setWordWrap(true);layout.addWidget(&hint);buttons(dialog,layout);while(dialog.exec()==QDialog::Accepted){try{QStringList fields{QString::number(level.value()),QString::number(alignment.value())};for(int bank=0;bank<3;bank++)for(int row=0;row<7;row++)fields<<table.item(row,bank)->text();auto definition=fields.join(' ').toStdString();questValues(definition);definitions[id]=definition;normal[id]=worlded::utf8_cp1252(journal.toPlainText().toStdString());dumb[id]=worlded::utf8_cp1252(lowJournal.toPlainText().toStdString());applyResources({{"rules/gamequest.mes",messageBytes(definitions)},{"mes/gamequestlog.mes",messageBytes(normal)},{"mes/gamequestlogdumb.mes",messageBytes(dumb)}});return;}catch(const std::exception& e){QMessageBox::warning(&dialog,"Invalid quest",e.what());}}
    }
    static QStringList areaParts(const std::string& text){auto sections=QString::fromStdString(worlded::cp1252_utf8(text)).split('/');if(sections.size()<3 || sections.size()>4)throw std::runtime_error("Area requires coordinates/name/description and optional /Radius:");auto numbers=sections[0].split(',');if(numbers.size()<4)throw std::runtime_error("Area requires X, Y and two label offsets");for(int i=0;i<4;i++){bool ok;numbers[i].trimmed().toInt(&ok);if(!ok)throw std::runtime_error("Invalid area coordinates");}return sections;}
    void editArea(){auto areas=messages("mes/gamearea.mes");bool ok;int next=areas.empty()?0:int(areas.rbegin()->first+1);int id=QInputDialog::getInt(this,"World area","Existing ID, or the next ID to append a new area",next,0,next,1,&ok);if(!ok)return;if(!areas.count(id) && id!=next)throw std::runtime_error("Append new areas after existing IDs to preserve saved area indices");QStringList parts{"0,0,0,0","","","Radius: 3"};if(areas.count(id))parts=areaParts(areas[id]);QDialog dialog(this);dialog.setWindowTitle(QString("World area %1").arg(id));QVBoxLayout layout(&dialog);QFormLayout form;auto coordinates=parts[0].split(',');QSpinBox x,y,ox,oy,radius;for(auto spin:{&x,&y})spin->setRange(0,262143);for(auto spin:{&ox,&oy})spin->setRange(-32768,32767);radius.setRange(0,4096);radius.setValue(3);x.setValue(coordinates[0].toInt());y.setValue(coordinates[1].toInt());ox.setValue(coordinates[2].toInt());oy.setValue(coordinates[3].toInt());if(parts.size()>3){auto match=QRegularExpression("Radius:\\s*(\\d+)").match(parts[3]);if(!match.hasMatch())throw std::runtime_error("Unsupported area options; preserve them through the native table editor");radius.setValue(match.captured(1).toInt());}QLineEdit name(parts[1]),description(parts[2]);form.addRow("Absolute tile X",&x);form.addRow("Absolute tile Y",&y);form.addRow("Label offset X",&ox);form.addRow("Label offset Y",&oy);form.addRow("Discovery radius (sectors)",&radius);form.addRow("Name",&name);form.addRow("Description",&description);layout.addLayout(&form);buttons(dialog,layout);if(dialog.exec()!=QDialog::Accepted)return;if(name.text().contains('/') || description.text().contains('/'))throw std::runtime_error("Area names and descriptions cannot contain slash separators");auto text=QString("%1,%2,%3,%4/%5/%6/Radius: %7").arg(x.value()).arg(y.value()).arg(ox.value()).arg(oy.value()).arg(name.text()).arg(description.text()).arg(radius.value());areas[id]=worlded::utf8_cp1252(text.toStdString());set("mes/gamearea.mes",messageBytes(areas));}
    void editEncounterRegion(){auto entries=messages("rules/wmap_rnd.mes");bool ok;auto kind=QInputDialog::getItem(this,"Encounter region","Region type",{"Frequency","Power","Table override"},0,false,&ok);if(!ok)return;int base=kind=="Frequency"?10000:kind=="Power"?20000:30000;int next=base;while(entries.count(next))next++;int id=QInputDialog::getInt(this,"Encounter region","Existing or next contiguous record",next,base,next,1,&ok);if(!ok)return;QStringList parts{"0","0","0",kind=="Power"?"average":"0"};if(entries.count(id))parts=QString::fromStdString(entries[id]).split(',');if(parts.size()!=4)throw std::runtime_error("Expected X,Y,radius,value for this region");QDialog dialog(this);dialog.setWindowTitle(kind+" region");QVBoxLayout layout(&dialog);QFormLayout form;QSpinBox x,y,radius,value;for(auto spin:{&x,&y,&radius})spin->setRange(0,262143);x.setValue(parts[0].toInt());y.setValue(parts[1].toInt());radius.setValue(parts[2].toInt());value.setRange(kind=="Frequency"?0:-1,kind=="Frequency"?100:4095);value.setValue(parts[3].toInt());QComboBox power;power.addItems({"none","easy","average","powerful"});power.setCurrentText(parts[3].trimmed().toLower());form.addRow("Center tile X",&x);form.addRow("Center tile Y",&y);form.addRow("Radius (tiles)",&radius);form.addRow(kind=="Frequency"?"Frequency (%)":kind=="Power"?"Power":"Encounter table index",kind=="Power"?static_cast<QWidget*>(&power):&value);layout.addLayout(&form);buttons(dialog,layout);if(dialog.exec()!=QDialog::Accepted)return;if(kind=="Table override" && value.value()>=54+QString::fromStdString(entries[49999]).toInt())throw std::runtime_error("Encounter table index is not declared by record 49999");entries[id]=QString("%1, %2, %3, %4").arg(x.value()).arg(y.value()).arg(radius.value()).arg(kind=="Power"?power.currentText():QString::number(value.value())).toStdString();set("rules/wmap_rnd.mes",messageBytes(entries));}
    void editEncounter(){auto entries=messages("rules/wmap_rnd.mes");bool ok;int id=QInputDialog::getInt(this,"Encounter group","Record ID: 50000 + table index × 100 + entry index",50000,50000,459499,1,&ok);if(!ok)return;if(id%100 && !entries.count(id-1))throw std::runtime_error("Encounter table entries must be contiguous");auto raw=QString::fromStdString(entries.count(id)?entries[id]:"1, First: 17305, 1-1");QDialog dialog(this);dialog.setWindowTitle(QString("Encounter record %1").arg(id));dialog.resize(780,570);QVBoxLayout layout(&dialog);QFormLayout form;QSpinBox weight;weight.setRange(1,32000);weight.setValue(raw.section(',',0,0).toInt());form.addRow("Selection weight",&weight);layout.addLayout(&form);QTableWidget groups(5,3);groups.setHorizontalHeaderLabels({"NPC prototype (0 = unused)","Minimum count","Maximum count"});groups.horizontalHeader()->setSectionResizeMode(QHeaderView::Stretch);QStringList groupNames{"First","Second","Third","Fourth","Fifth"};groups.setVerticalHeaderLabels(groupNames);QString tail=raw.section(',',1);for(int row=0;row<5;row++){auto re=QRegularExpression(groupNames[row]+":\\s*(\\d+)\\s*,\\s*(\\d+)\\s*-\\s*(\\d+)",QRegularExpression::CaseInsensitiveOption);auto match=re.match(raw);for(int c=0;c<3;c++)groups.setItem(row,c,new QTableWidgetItem(match.hasMatch()?match.captured(c+1):"0"));tail.remove(re);}layout.addWidget(&groups);QLineEdit options(tail.trimmed().remove(QRegularExpression("^[,\\s]+")));QLabel hint("Optional native clauses such as MinLevel:, GlobalFlag: and TriggerCount: follow the groups. Prototype numbers must refer to NPCs in this installation. Add groups without gaps.");hint.setWordWrap(true);layout.addWidget(&hint);layout.addWidget(&options);buttons(dialog,layout);while(dialog.exec()==QDialog::Accepted){try{QString record=QString::number(weight.value());bool ended=false;int count=0;for(int row=0;row<5;row++){bool valid[3];unsigned values[3];for(int c=0;c<3;c++)values[c]=groups.item(row,c)->text().toUInt(&valid[c]);if(!valid[0] || !valid[1] || !valid[2])throw std::runtime_error("Group fields must be unsigned integers");if(!values[0]){ended=true;continue;}if(ended || !values[1] || values[1]>values[2] || values[2]>32000)throw std::runtime_error("Group counts must satisfy 1 <= minimum <= maximum <= 32000; no gaps between groups");bool found=false;for(auto& resource:installation.resources())if(resource.first.rfind("proto/",0)==0 && QRegularExpression("^proto/(\\d+)").match(QString::fromStdString(resource.first)).captured(1).toUInt()==values[0]){auto objects=worlded::read_objects(installation.read(resource.first));found=!objects.empty() && objects[0].type==16;break;}if(!found)throw std::runtime_error("NPC prototype not found: "+std::to_string(values[0]));record+=QString(", %1: %2, %3-%4").arg(groupNames[row]).arg(values[0]).arg(values[1]).arg(values[2]);count++;}if(!count)throw std::runtime_error("At least one NPC group is required");if(!options.text().trimmed().isEmpty())record+=", "+options.text().trimmed();entries[id]=record.toStdString();auto table=(id-50000)/100;auto declared=QString::fromStdString(entries[49999]).toInt();if(table>=54+declared)entries[49999]=std::to_string(table-53);set("rules/wmap_rnd.mes",messageBytes(entries));return;}catch(const std::exception& e){QMessageBox::warning(&dialog,"Invalid encounter",e.what());}}
    }

    static unsigned nativeWord(const worlded::Bytes& b,unsigned p){worlded::BinaryReader in(b,p);return in.u32();}
    static void nativePut(worlded::Bytes& b,unsigned p,unsigned value){if(p+4>b.size())throw std::runtime_error("Invalid binary field");for(unsigned i=0;i<4;i++)b[p+i]=value>>(i*8);}
    void editTownmap(){bool ok;auto operation=QInputDialog::getItem(this,"Townmaps","Operation",{"Create and assign a townmap","Generate artwork in a test copy"},0,false,&ok);if(!ok)return;if(operation.startsWith("Generate")){generateTownmap();return;}auto towns=messages("rules/townmap.mes");QDialog dialog(this);dialog.setWindowTitle("Create and assign a townmap");QVBoxLayout layout(&dialog);QFormLayout form;QSpinBox id,x,y,w,h;id.setRange(1,999999);id.setValue(towns.empty()?1:towns.rbegin()->first+1);for(auto spin:{&x,&y})spin->setRange(0,4095);for(auto spin:{&w,&h}){spin->setRange(1,16);spin->setValue(1);}QLineEdit name;name.setPlaceholderText("my-town");QComboBox map;for(auto record:worlded::read_messages(read("rules/maplist.mes")))if(record.id>=5000){auto folder=QString::fromStdString(record.text).section(',',0,0).trimmed();map.addItem(folder,folder);}QCheckBox wait("Allow waiting in this town");form.addRow("Townmap ID",&id);form.addRow("Resource folder name",&name);form.addRow("Campaign map",&map);form.addRow("First sector X",&x);form.addRow("First sector Y",&y);form.addRow("Sector width",&w);form.addRow("Sector height",&h);form.addRow(&wait);layout.addLayout(&form);QLabel hint("Assigns every sector in the rectangle and creates native townmap metadata. Existing town IDs are not overwritten. Generate the artwork in a test copy, then import it into this project.");hint.setWordWrap(true);layout.addWidget(&hint);buttons(dialog,layout);if(dialog.exec()!=QDialog::Accepted)return;if(towns.count(id.value()))throw std::runtime_error("This townmap ID already exists");if(w.value()*h.value()>64)throw std::runtime_error("Assign at most 64 sectors per townmap operation");auto folder=name.text().trimmed().toLower();if(!QRegularExpression("^[a-z0-9][a-z0-9_-]{0,39}$").match(folder).hasMatch())throw std::runtime_error("Use a short lowercase folder name without spaces");auto sourceMap=map.currentData().toString().toStdString();if(sourceMap.empty())throw std::runtime_error("Choose a campaign map");auto prefix="townmap/"+folder.toStdString()+"/"+folder.toStdString();if(installation.contains(prefix+".tmi") || changes.count(prefix+".tmi"))throw std::runtime_error("This townmap folder already exists");worlded::Bytes tmi(48);nativePut(tmi,0,2);nativePut(tmi,8,id.value());unsigned width=((unsigned(w.value()+h.value())*64*40+1023)/1024)*1024,height=((unsigned(w.value()+h.value())*64*20+1023)/1024)*1024;nativePut(tmi,12,width);nativePut(tmi,16,height);nativePut(tmi,20,width/1024);nativePut(tmi,24,height/1024);nativePut(tmi,32,x.value()*64+w.value()*32);nativePut(tmi,36,y.value()*64+h.value()*32);nativePut(tmi,40,0x3e000000); // 0.125f; one 128px BMP per 1024px native-render tile.
        std::map<std::string,worlded::Bytes> updates;updates[prefix+".tmi"]=tmi;towns[id.value()]=folder.toStdString()+(wait.isChecked()?" [w:1]":" [w:0]");updates["rules/townmap.mes"]=messageBytes(towns);
        auto props=read("maps/"+sourceMap+"/map.prp");if(props.size()!=24 || unsigned(x.value()+w.value())>nativeWord(props,8)/64 || unsigned(y.value()+h.value())>nativeWord(props,16)/64)throw std::runtime_error("Townmap rectangle lies outside the campaign map");
        for(int py=y.value();py<y.value()+h.value();py++)for(int px=x.value();px<x.value()+w.value();px++){auto key="maps/"+sourceMap+"/"+std::to_string(std::uint64_t(px)|(std::uint64_t(py)<<26))+".sec";auto bytes=read(key);worlded::Sector sector=bytes.empty()?worlded::read_world_sector(installation,sourceMap,px,py,&changes).sector:worlded::Sector(bytes);if(bytes.empty()){worlded::Building generated{worlded::BuildingPlan{},sector,worlded::sector_objects(sector),{}};for(auto& object:generated.objects){if(object.type!=3)throw std::runtime_error("Generated terrain with non-scenery objects needs a zone project before townmap assignment");object=worlded::clone_instance(object);auto loc=object.number("LOCATION");worlded::set_number(object,"LOCATION",(std::uint64_t(px*64)+(loc&63))|((std::uint64_t(py*64)+((loc>>32)&63))<<32));}sector=generated.sector();auto lights=sector.lights();for(auto& light:lights){nativePut(light,8,px*64+(nativeWord(light,8)&63));nativePut(light,12,py*64+(nativeWord(light,12)&63));}sector.set_lights(lights);}if(sector.info().townmap && sector.info().townmap!=unsigned(id.value()))throw std::runtime_error("A selected sector already belongs to another townmap");sector.set_townmap(id.value());updates[key]=sector.encode();}
        // A neutral fallback lets the native UI load before artwork is generated.
        QImage fallback(128,128,QImage::Format_RGB32);fallback.fill(QColor("#272520"));QPainter painter(&fallback);painter.setPen(QColor("#a49a83"));painter.drawText(fallback.rect(),Qt::AlignCenter,"Generate\ntownmap");painter.end();QByteArray bitmap;QBuffer buffer(&bitmap);buffer.open(QIODevice::WriteOnly);if(!fallback.save(&buffer,"BMP"))throw std::runtime_error("Cannot encode townmap bitmap");updates[prefix+"000000.bmp"]=worlded::Bytes(bitmap.begin(),bitmap.end());applyResources(std::move(updates));
    }
    static std::map<std::string,worlded::Bytes> townmapImages(const QString& game,unsigned id,const worlded::Bytes& tmi,const std::string& prefix){std::map<std::string,worlded::Bytes> updates;auto cols=nativeWord(tmi,20),rows=nativeWord(tmi,24);for(unsigned y=0;y<rows;y++)for(unsigned x=0;x<cols;x++){auto png=QDir(game).filePath(QString("modern-ui/local-maps/Arcanum/%1/3_%2_%3.png").arg(id).arg(x).arg(y));QImage image(png);if(image.size()!=QSize(128,128))throw std::runtime_error("Missing or invalid generated tile: "+png.toStdString());QByteArray bytes;QBuffer buffer(&bytes);buffer.open(QIODevice::WriteOnly);if(!image.convertToFormat(QImage::Format_RGB32).save(&buffer,"BMP"))throw std::runtime_error("Cannot encode generated bitmap");auto key=prefix+QString("%1.bmp").arg(y*cols+x,6,10,QChar('0')).toStdString();updates[key]=worlded::Bytes(bytes.begin(),bytes.end());}return updates;}
    void generateTownmap(){auto towns=messages("rules/townmap.mes");QStringList choices;std::vector<unsigned> ids;for(auto [id,name]:towns){choices<<QString("%1 · %2").arg(id).arg(QString::fromStdString(name));ids.push_back(id);}bool ok;auto choice=QInputDialog::getItem(this,"Generate townmap","Townmap",choices,0,false,&ok);if(!ok || choice.isEmpty())return;auto id=ids.at(choices.indexOf(choice));auto name=QString::fromStdString(towns.at(id)).section('[',0,0).trimmed();auto prefix="townmap/"+name.toStdString()+"/"+name.toStdString();auto tmi=read(prefix+".tmi");if(tmi.size()!=48 || nativeWord(tmi,0)!=2)throw std::runtime_error("Invalid townmap metadata");if(nativeWord(tmi,40)!=0x3e000000 || nativeWord(tmi,12)!=nativeWord(tmi,20)*1024 || nativeWord(tmi,16)!=nativeWord(tmi,24)*1024)throw std::runtime_error("Native artwork import currently requires a townmap created by this editor (1024-pixel tiles at 1/8 scale)");auto root=QFileDialog::getExistingDirectory(this,"Choose the test-copy folder containing .worlded-campaign-test");if(root.isEmpty())return;QFile marker(QDir(root).filePath(".worlded-campaign-test"));if(!marker.open(QIODevice::ReadOnly))throw std::runtime_error("This is not a marked independent campaign test copy");auto meta=QJsonDocument::fromJson(marker.readAll()).object();if(meta["format"]!="worlded-campaign-test" || meta["project"].toString()!=QFileInfo(projectPath).canonicalFilePath())throw std::runtime_error("The copy belongs to another campaign project");auto game=QDir(root).filePath("game");auto relative=meta["executable"].toString();if(QFileInfo(relative).fileName()!=relative)throw std::runtime_error("Invalid copied executable name");auto targetTmi=QDir(game).filePath("modules/Arcanum/"+QString::fromStdString(prefix+".tmi"));QFile current(targetTmi);if(!current.open(QIODevice::ReadOnly) || current.readAll()!=QByteArray(reinterpret_cast<const char*>(tmi.data()),int(tmi.size())))throw std::runtime_error("Recreate the test copy with this project's townmap changes before generating");
        QFile engine(QDir(game).filePath(relative));if(!engine.open(QIODevice::ReadOnly) || engine.size()>128*1024*1024 || !engine.readAll().contains("../.worlded-campaign-test"))throw std::runtime_error("Choose a Renaissance engine with the WorldED townmap filter; rebuild the campaign copy with the matching executable");QProcess process;process.setProgram(QDir(game).filePath(relative));process.setWorkingDirectory(game);process.setArguments({"--modern-generate-maps",game,"0",QString::number(id)});process.setProcessChannelMode(QProcess::MergedChannels);auto log=QDir(root).filePath("townmap-generation.log");process.setStandardOutputFile(log);process.start();if(!process.waitForStarted(5000))throw std::runtime_error("Cannot start the native map generator");QProgressDialog progress("Rendering townmap in the independent copy…","Cancel generation",0,0,this);progress.setWindowModality(Qt::ApplicationModal);progress.show();while(!process.waitForFinished(30)){QApplication::processEvents();if(progress.wasCanceled()){process.kill();process.waitForFinished(5000);throw std::runtime_error("Generation cancelled; project resources were not changed");}}progress.close();if(process.exitStatus()!=QProcess::NormalExit || process.exitCode()!=0)throw std::runtime_error("Townmap generation failed. See "+log.toStdString());
        auto updates=townmapImages(game,id,tmi,prefix);applyResources(std::move(updates));state->setText("Townmap artwork imported. Save the project and recreate/export the campaign copy to include native BMP tiles.");
    }
