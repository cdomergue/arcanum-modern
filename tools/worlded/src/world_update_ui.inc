    void adoptUpdateReference(){if(!editing() || !installation)return;if(building->reference){QMessageBox::information(this,"Original reference","This project already has a captured reference. It is kept independently of ordinary saves and cannot be silently replaced.");return;}if(QMessageBox::question(this,"Adopt reference for this older project","Use the currently mounted installation as the original reference? Exact object identities will be checked. This does not establish that it matches a historical release; choose the installation this project was created from.",QMessageBox::Yes|QMessageBox::Cancel,QMessageBox::Cancel)!=QMessageBox::Yes)return;try{auto next=*building;adopt_scene_reference(next,*installation);commitEdit("Adopt original reference",next.objects,selectedIds(),nullptr,&next);statusBar()->showMessage("Original reference captured. Save the project to preserve it.");}catch(const std::exception& e){QMessageBox::warning(this,"Cannot adopt reference",utf8(e.what()));}}
    void importUpdateObject(){if(!editing() || !installation)return;try{if(!building->reference)throw std::runtime_error("Adopt an original reference first (Zone > Update reference…).");auto mobiles=reference_mobiles(*installation,*building);QStringList choices;for(const auto& item:mobiles)choices<<QString("%1 · prototype %2 · %3").arg(assets->description(item.object)).arg(item.object.prototype_id).arg(QString::fromStdString(item.object.id));if(choices.isEmpty()){QMessageBox::information(this,"Campaign objects","No additional GUID campaign objects are available in this sector.");return;}bool ok;auto chosen=QInputDialog::getItem(this,"Import campaign object for update","Preserve the existing GUID; changes will be reviewed before export",choices,0,false,&ok);if(!ok)return;auto next=*building;import_reference_mobile(next,*installation,mobiles.at(choices.indexOf(chosen)));auto key=next.objects.back().editor_id;commitEdit("Import campaign object for update",next.objects,{key},nullptr,&next);}catch(const std::exception& e){QMessageBox::warning(this,"Cannot import campaign object",utf8(e.what()));}}
    void exportUpdatePackage(){if(!editing() || !installation)return;try{
        if(!building->reference)throw std::runtime_error("This older project has no original reference. Use Zone > Update reference… before exporting an update.");
        if(!saveActive())return;auto history=updateHistory(*building);auto previous=history["manifest"].toObject();QDialog settings(this);settings.setWindowTitle("Renaissance update package");QVBoxLayout layout(&settings);QFormLayout form;QLineEdit package(previous.isEmpty()?"worlded-"+QString::fromStdString(building->reference->id):previous["package_id"].toString()),version(previous.isEmpty()?"1.0.0":previous["version"].toString());package.setReadOnly(!previous.isEmpty());QSpinBox revision;revision.setRange(1,INT_MAX);revision.setValue(previous.isEmpty()?1:previous["revision"].toInt()+1);revision.setReadOnly(true);QPlainTextEdit dependencies;dependencies.setMaximumHeight(110);QStringList lines;for(auto item:previous["requires"].toArray()){auto dependency=item.toObject();lines<<dependency["package_id"].toString()+" "+QString::number(dependency["min_revision"].toInt());}dependencies.setPlainText(lines.join('\n'));form.addRow("Stable package ID",&package);form.addRow("Display version",&version);form.addRow("Revision",&revision);form.addRow("Dependencies (package ID, space, minimum revision)",&dependencies);layout.addLayout(&form);QLabel hint("This export contains guarded operations for existing saves. It does not replace campaign SEC files. Published operations and resources remain immutable in later revisions.");hint.setWordWrap(true);layout.addWidget(&hint);QDialogButtonBox buttons(QDialogButtonBox::Ok|QDialogButtonBox::Cancel);buttons.button(QDialogButtonBox::Ok)->setText("Review changes…");layout.addWidget(&buttons);connect(&buttons,&QDialogButtonBox::accepted,&settings,&QDialog::accept);connect(&buttons,&QDialogButtonBox::rejected,&settings,&QDialog::reject);if(settings.exec()!=QDialog::Accepted)return;QJsonArray requires;for(auto line:dependencies.toPlainText().split('\n',Qt::SkipEmptyParts)){auto parts=line.trimmed().split(QRegularExpression("\\s+"));bool ok=false;auto rev=parts.size()==2?parts[1].toUInt(&ok):0;if(!ok || !rev)throw std::runtime_error("Dependency lines require a package ID and a positive minimum revision");requires.append(QJsonObject{{"package_id",parts[0]},{"min_revision",int(rev)}});}
        auto review=reviewWorldUpdate(*building,*installation,package.text().trimmed(),version.text().trimmed(),revision.value(),requires);QDialog dialog(this);dialog.setWindowTitle("Review Renaissance update");dialog.resize(950,680);QVBoxLayout content(&dialog);QLabel summary(QString("%1 new operations · %2 cumulative operations · %3 resources · %4 unsupported changes").arg(review.rows.size()).arg(review.operations.size()).arg(review.resources.size()).arg(review.unsupported.size()));summary.setWordWrap(true);content.addWidget(&summary);QTextBrowser details;QStringList report;report<<"CHANGES IN THIS REVISION";report<<review.rows;report<<""<<"PRESERVED PLAYER STATE"<<"Only listed fields/cells are changed. Moving a container keeps its identity, inventory, lock and scripts. Missing or divergent targets are reported as conflicts; additions do not respawn after successful installation.";if(!review.unsupported.empty())report<<""<<"EXPORT BLOCKED"<<review.unsupported;details.setPlainText(report.join('\n'));content.addWidget(&details,1);QDialogButtonBox controls(QDialogButtonBox::Save|QDialogButtonBox::Cancel);controls.button(QDialogButtonBox::Save)->setText("Export reviewed package…");controls.button(QDialogButtonBox::Save)->setEnabled(review.unsupported.isEmpty() && !review.rows.isEmpty());content.addWidget(&controls);connect(&controls,&QDialogButtonBox::accepted,&dialog,&QDialog::accept);connect(&controls,&QDialogButtonBox::rejected,&dialog,&QDialog::reject);if(dialog.exec()!=QDialog::Accepted)return;
