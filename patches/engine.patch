+            ? charedit_skills_plus_buttons[index].button_handle : charedit_skills_minus_buttons[index].button_handle;
+        charedit_skills_win_message_filter(&message);
+    } else if (category == 2 && index >= 0 && index < TECH_COUNT) {
+        /* Classic +/- buttons are created only when their panel is refreshed. */
+        int degree = tech_degree_get(charedit_obj, index);
+        if (direction > 0 && degree < DEGREE_COUNT - 1) tech_ui_inc_degree(charedit_obj, index);
+        else if (direction < 0 && degree > 0) tech_ui_dec_degree(charedit_obj, index);
+    } else if (category == 3 && index >= 0 && index < COLLEGE_COUNT) {
+        int level = spell_college_level_get(charedit_obj, index);
+        if (direction > 0 && level < 5) spell_ui_add(charedit_obj, 5 * index + level);
+        else if (direction < 0 && level > dword_64D364[index])
