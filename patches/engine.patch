+bool modern_spell_resources(int64_t actor, int spell, int* fatigue_cost)
+{
+    *fatigue_cost = 0;
+    if (!actor || spell < 0 || spell >= SPELL_COUNT || !spell_is_known(actor, spell)) return false;
+    int check = magictech_spells[spell].cost;
+    int charge = check;
+    if (spell_mastery_get(actor) == COLLEGE_FROM_SPELL(spell)) {
+        charge /= 2;
+        if (charge & 1) charge++;
+    }
+    if (magictech_cheat_mode) check = charge = 1;
+    if (stat_level_get(actor, STAT_RACE) == RACE_DWARF) { check *= 2; charge *= 2; }
+    if (obj_field_int32_get(actor, OBJ_F_CRITTER_FLAGS) & OCF_FATIGUE_LIMITING) {
+        if (check > 0) {check /= 2; if (!check) check = 1;}
+        if (charge > 0) {charge /= 2; if (!charge) charge = 1;}
+    }
+    for (int slot = FIRST_WEAR_INV_LOC; slot <= LAST_WEAR_INV_LOC; slot++) {
+        int64_t item = item_wield_get(actor, slot);
+        if (item) {
+            int mana = obj_field_int32_get(item, OBJ_F_ITEM_MANA_STORE);
+            if (mana > 0) {check -= mana; charge -= mana;}
+        }
+    }
+    *fatigue_cost = charge > 0 ? charge : 0;
+    return check <= 0 || critter_fatigue_current(actor) - check > -15;
+}
+
+int modern_maintained_spells(int64_t actor, int* ids, int* spells, int capacity)
+{
+    int count = 0;
+    if (!actor || !magictech_run_info || !magictech_spells) return 0;
+    for (int i = 0; i < 512 && count < capacity; i++) {
+        MagicTechRunInfo* run = &magictech_run_info[i];
+        if ((run->flags & MAGICTECH_RUN_ACTIVE) && run->source_obj.obj == actor
+            && run->spell >= 0 && run->spell < SPELL_COUNT
+            && magictech_spells[run->spell].maintenance.period > 0
+            && run->action != MAGICTECH_ACTION_END) {
+            ids[count] = run->id; spells[count++] = run->spell;
+        }
+    }
+    return count;
+}
+
+bool modern_spell_stop(int64_t actor, int id)
+{
+    MagicTechRunInfo* run;
+    if (!magictech_spells || !magictech_run_info || id < 0 || id >= 512
+        || !combat_input_ready(actor) || !magictech_id_to_run_info(id, &run)
+        || !(run->flags & MAGICTECH_RUN_ACTIVE) || run->action == MAGICTECH_ACTION_END
+        || run->source_obj.obj != actor || run->spell < 0 || run->spell >= SPELL_COUNT
+        || magictech_spells[run->spell].maintenance.period <= 0) return false;
+    magictech_interrupt(id);
+    return true;
+}
