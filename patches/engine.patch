+void modern_mainmenu_save_select(int index)
+{
+    if (!modern_mainmenu_save_screen()) return;
+    bool saving = mainmenu_ui_window_type == MM_WINDOW_SAVE_GAME;
+    if (index < 0 || index >= (int)mainmenu_ui_gsl.count + saving) return;
+    main_menu_window_info[mainmenu_ui_window_type]->selected_index = index;
+    if (mainmenu_ui_gsi_loaded) gamelib_saveinfo_exit(&mainmenu_ui_gsi);
+    mainmenu_ui_gsi_loaded = false;
