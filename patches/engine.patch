+/* Presentation adapters retain the installed command strings and native orders. */
+static void follower_ui_dispatch_command(int index)
+{
+    MesFileEntry mes_file_entry;
+    char str[MAX_STRING];
+    Broadcast bcast;
+    switch (index) {
+    case FOLLOWER_UI_COMMAND_WALK:
+    case FOLLOWER_UI_COMMAND_ATTACK:
+        // Enter targeting mode. The player needs to click
+        // a tile or object to complete the order.
+        follower_ui_begin_order_mode(index);
+        break;
+    case FOLLOWER_UI_COMMAND_INVENTORY:
+        // Open barter inventory if permitted.
+        if (inven_ui_can_open_inven(follower_ui_commander_obj, follower_ui_subordinate_obj)) {
+            inven_ui_open(follower_ui_commander_obj, follower_ui_subordinate_obj, INVEN_UI_MODE_BARTER);
+        }
+        break;
+    case FOLLOWER_UI_COMMAND_CHARACTER_SHEET:
+        charedit_open(follower_ui_subordinate_obj, CHAREDIT_MODE_PASSIVE);
+        break;
+    case FOLLOWER_UI_COMMAND_WAIT:
+        // Mind-controlled followers cannot be ordered to wait.
+        if ((obj_field_int32_get(follower_ui_subordinate_obj, OBJ_F_SPELL_FLAGS) & OSF_MIND_CONTROLLED) != 0) {
+            return;
+        }
+        // FALLTHROUGH
+    default:
+        // Stay Close, Spread Out, Back Off, and Wait (when
+        // not mind-controlled) are issued as broadcast
+        // messages.
+        mes_file_entry.num = index;
+        if (mes_search(follower_ui_mes_file, &mes_file_entry)) {
+            object_examine(follower_ui_subordinate_obj, follower_ui_commander_obj, str);
+            snprintf(bcast.str, sizeof(bcast.str), "%s %s", str, mes_file_entry.str);
+            broadcast_msg(follower_ui_commander_obj, &bcast);
+        }
+        break;
+    }
+}
+
+void modern_followers_sync(bool hidden)
+{
+    if (!follower_ui_initialized) return;
+    bool restore = modern_followers_hidden && !hidden;
+    modern_followers_hidden = hidden;
+    if (hidden) {
+        for (int i = 0; i < FOLLOWER_UI_BUTTON_COUNT; i++) {
+            if (!tig_window_is_hidden(follower_ui_windows[i])) tig_window_hide(follower_ui_windows[i]);
+        }
+        follower_ui_drop_down_menu_destroy();
+    } else if (restore) follower_ui_refresh();
+}
+
+int modern_followers_get(int64_t* objects, int capacity)
+{
+    int64_t pc = player_get_local_pc_obj();
+    if (!pc || !obj_handle_is_valid(pc)) return 0;
+    int count = obj_arrayfield_length_get(pc, OBJ_F_CRITTER_FOLLOWER_IDX);
+    int n = 0;
+    for (int i = 0; i < count && n < capacity; i++) {
+        int64_t obj = obj_arrayfield_handle_get(pc, OBJ_F_CRITTER_FOLLOWER_IDX, i);
+        if (obj && obj_handle_is_valid(obj)) objects[n++] = obj;
+    }
+    return n;
+}
+
+const char* modern_follower_text(int command)
+{
+    MesFileEntry entry = { .num = command };
+    return follower_ui_initialized && command >= 0 && command < FOLLOWER_UI_COMMAND_COUNT
+        && mes_search(follower_ui_mes_file, &entry) ? entry.str : "";
+}
+
+bool modern_follower_command_available(int64_t obj, int command)
+{
+    int64_t pc = player_get_local_pc_obj();
+    if (!follower_ui_initialized || !obj || !obj_handle_is_valid(obj)
+        || !pc || !player_is_local_pc_obj(critter_pc_leader_get(obj))
+        || dialog_ui_is_in_dialog(pc) || command < 0 || command >= FOLLOWER_UI_COMMAND_COUNT) return false;
+    if (command == FOLLOWER_UI_COMMAND_CHARACTER_SHEET) return true;
+    if (combat_turn_based_is_active()) {
+        /* Never issue AI orders or change the active actor through this menu. */
+        return command == FOLLOWER_UI_COMMAND_INVENTORY && obj == combat_input_actor() && combat_input_ready(obj);
+    }
+    if (command == FOLLOWER_UI_COMMAND_INVENTORY) return inven_ui_can_open_inven(pc, obj);
+    if (command == FOLLOWER_UI_COMMAND_WAIT) return (obj_field_int32_get(obj, OBJ_F_SPELL_FLAGS) & OSF_MIND_CONTROLLED) == 0;
+    return true;
+}
+
+void modern_follower_command(int64_t obj, int command)
+{
+    if (!modern_follower_command_available(obj, command)) return;
+    if (combat_turn_based_is_active() && command == FOLLOWER_UI_COMMAND_INVENTORY) {
+        inven_ui_open(obj, OBJ_HANDLE_NULL, INVEN_UI_MODE_INVENTORY);
+        return;
+    }
+    follower_ui_commander_obj = player_get_local_pc_obj();
+    follower_ui_subordinate_obj = obj;
+    follower_ui_dispatch_command(command);
+}
