+    case LOGBOOK_UI_TAB_REPUTATIONS: logbook_ui_format_reputation(text, capacity, index); break;
+    case LOGBOOK_UI_TAB_BLESSINGS_AND_CURSES: logbook_ui_format_blessing_or_curse(text, capacity, index); break;
+    case LOGBOOK_UI_TAB_KILLS_AND_INJURES: logbook_ui_format_kill_or_injury(text, capacity, index); break;
+    case LOGBOOK_UI_TAB_BACKGROUND:
+        SDL_strlcpy(text, background_description_get_body(logbook_ui_entry_ids[0]), capacity);
+        break;
+    case LOGBOOK_UI_TAB_KEYS: logbook_ui_format_key(text, capacity, index); break;
+    }
+    if (logbook_ui_entry_fonts[index] == logbook_ui_font_active) return 1;
+    if (logbook_ui_entry_fonts[index] == logbook_ui_font_quest_completed) return 2;
+    if (logbook_ui_entry_fonts[index] == logbook_ui_font_quest_failed
+        || logbook_ui_entry_fonts[index] == logbook_ui_font_curse) return 3;
+    if (logbook_ui_entry_fonts[index] == logbook_ui_font_struck) return 4;
