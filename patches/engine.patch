+/* Native presentation reads the same localized data as the original screens. */
+bool modern_mainmenu_character(ModernCharacter* character, int description)
+{
+    if (mainmenu_ui_window_type != MM_WINDOW_NEW_CHAR
+        && mainmenu_ui_window_type != MM_WINDOW_PREGEN_CHAR
+        && mainmenu_ui_window_type != MM_WINDOW_CHAREDIT) return false;
+    memset(character, 0, sizeof(*character));
+    character->editable = mainmenu_ui_window_type == MM_WINDOW_NEW_CHAR;
+    character->object = mainmenu_ui_window_type == MM_WINDOW_PREGEN_CHAR
+        ? qword_64C460 : player_get_local_pc_obj();
+    int64_t obj = character->object;
+    if (obj == OBJ_HANDLE_NULL) return false;
+    int race = stat_level_get(obj, STAT_RACE);
+    int gender = stat_level_get(obj, STAT_GENDER);
+    character->gender_editable = character->editable && !dword_5C3620
+        && race >= 0 && race < (int)SDL_arraysize(stru_5C5170)
+        && stru_5C5170[race].available_for_female;
+    character->portrait = portrait_get(obj);
+    character->index = mainmenu_ui_pregen_char_idx;
+    character->count = mainmenu_ui_pregen_char_cnt - 1;
+    if (character->editable) {
+        SDL_strlcpy(character->name, mainmenu_ui_textedit_buffer, sizeof(character->name));
+    } else {
+        char* name = NULL;
+        obj_field_string_get(obj, OBJ_F_PC_PLAYER_NAME, &name);
+        if (name) { SDL_strlcpy(character->name, name, sizeof(character->name)); FREE(name); }
+    }
+    MesFileEntry entry = { 0 };
+    entry.num = 740 + gender; mes_get_msg(mainmenu_ui_mainmenu_mes_file, &entry);
+    character->gender = entry.str;
+    entry.num = 720 + race; mes_get_msg(mainmenu_ui_mainmenu_mes_file, &entry);
+    character->race = entry.str;
+    int background = background_text_get(obj);
+    character->background = background_description_get_name(background);
+    character->description_kind = description == 2 && background <= 1000 ? 1 : description;
+    if (description == 2 && background > 1000) {
+        character->description = background_description_get_body(background);
+    } else {
+        entry.num = description == 0 ? 742 + gender : 770 + 2 * race + gender;
+        mes_get_msg(mainmenu_ui_mainmenu_mes_file, &entry);
+        character->description = entry.str;
+    }
+    return true;
