+static void slide_ui_draw_death(SDL_Renderer* renderer)
+{
+    int width, height, old_width, old_height;
+    SDL_RendererLogicalPresentation old_mode;
+    SDL_GetRenderOutputSize(renderer, &width, &height);
+    SDL_GetRenderLogicalPresentation(renderer, &old_width, &old_height, &old_mode);
+    SDL_SetRenderLogicalPresentation(renderer, width, height, SDL_LOGICAL_PRESENTATION_DISABLED);
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    SDL_RenderFillRect(renderer, NULL);
+    float scale = (float)width / slide_ui_death_width;
+    if (scale * slide_ui_death_height > height) scale = (float)height / slide_ui_death_height;
+    SDL_FRect rect = { (width - slide_ui_death_width * scale) / 2,
+        (height - slide_ui_death_height * scale) / 2,
+        slide_ui_death_width * scale, slide_ui_death_height * scale };
+    SDL_RenderTexture(renderer, slide_ui_death_texture, NULL, &rect);
+    SDL_SetRenderLogicalPresentation(renderer, old_width, old_height, old_mode);
+}
+
+static bool slide_ui_load_death(int slide)
+{
+    /* Only replace the default grave slide; retain story-specific slides. */
+    if (slide_ui_type != SLIDE_UI_TYPE_DEATH || slide != 0) return false;
+    SDL_Renderer* renderer;
+    if (tig_video_renderer_get(&renderer) != TIG_OK) return false;
+    SDL_Surface* image = SDL_LoadPNG("modern-ui/death-background.png");
+    if (!image) return false;
+    slide_ui_death_width = image->w;
+    slide_ui_death_height = image->h;
+    slide_ui_death_texture = SDL_CreateTextureFromSurface(renderer, image);
+    SDL_DestroySurface(image);
+    if (!slide_ui_death_texture) return false;
+    SDL_SetTextureScaleMode(slide_ui_death_texture, SDL_SCALEMODE_LINEAR);
+    tig_video_set_slide_overlay(slide_ui_draw_death);
+    return true;
+}
 
