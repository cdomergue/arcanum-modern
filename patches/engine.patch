+/* Read the controls already owned by the options screen, including its MES values. */
+bool modern_cyclic_state(int id,ModernOption* option)
+{
+    CyclicUiControl* ctrl;
+    if(!get_control(&ctrl,id,__FUNCTION__))return false;
+    *option=(ModernOption){.label=ctrl->info.title,.text=NULL,.value=ctrl->value,
+        .maximum=ctrl->max_value,.enabled=ctrl->info.enabled,
+        .numeric=ctrl->info.type==CYCLIC_UI_CONTROL_NUMERIC_BAR};
+    if(ctrl->info.type==CYCLIC_UI_CONTROL_MESSAGE_FILE) {
+        MesFileEntry entry={.num=ctrl->value};
+        if(mes_search(ctrl->mes_file,&entry))option->text=entry.str;
+    } else if(ctrl->info.type==CYCLIC_UI_CONTROL_TEXT_ARRAY
+        && ctrl->value>=0 && ctrl->value<ctrl->info.text_array_size)
+        option->text=ctrl->info.text_array[ctrl->value];
+    return true;
+}
+void modern_cyclic_adjust(int id,int direction)
+{
+    CyclicUiControl* ctrl;
+    if(!get_control(&ctrl,id,__FUNCTION__) || !ctrl->info.enabled)return;
+    if(direction<0)cycle_left(ctrl);else if(direction>0)cycle_right(ctrl);
+}
