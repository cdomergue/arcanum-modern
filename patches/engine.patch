+    *state=(ModernMap){.mode=wmap_ui_mode,.x=info->field_14.x,.y=info->field_14.y,
+        .width=info->field_14.width,.height=info->field_14.height,.buffer=buffer,
+        .offset_x=info->field_34,.offset_y=info->field_38,
+        .map=wmap_ui_mode==WMAP_UI_MODE_TOWN?map_current_map():0,
+        .townmap=wmap_ui_mode==WMAP_UI_MODE_TOWN?wmap_ui_townmap:0,
+        .origin_x=info->rect.x-info->field_14.x,
+        .origin_y=info->rect.y+wmap_ui_window_frame.y-info->field_14.y,
+        .moving=wmap_ui_state==WMAP_UI_STATE_MOVING};
+    return buffer!=NULL;
+}
+void modern_map_hd_enable(bool enabled)
+{
+    enabled=enabled && modern_ui_enabled() && wmap_ui_mode==WMAP_UI_MODE_TOWN;
+    if(modern_map_hd==enabled)return;
+    modern_map_hd=enabled;
+    if(wmap_ui_created && wmap_ui_mode==WMAP_UI_MODE_TOWN)wmap_town_refresh_rect(NULL);
+}
+void modern_map_mouse(int x,int y,int event)
+{
+    if(!wmap_ui_created)return;
+    TigRect rect={0,0,800,600};hrp_apply(&rect,GRAVITY_CENTER_HORIZONTAL|GRAVITY_CENTER_VERTICAL);
+    TigMessage message={0};message.type=TIG_MESSAGE_MOUSE;
+    message.data.mouse.x=x+rect.x;message.data.mouse.y=y+rect.y;message.data.mouse.event=event;
+    wmap_ui_message_filter(&message);
+}
+void modern_map_action(int action)
+{
+    if(!wmap_ui_created)return;
+    if(action==0){wmap_ui_close();return;}
+    if(action==8){
+        modern_map_buttons_hidden=modern_ui_enabled();
+        if(!modern_map_buttons_hidden)modern_map_hd=false;
+        for(int i=0;i<2;i++) {
+            if(modern_map_buttons_hidden)tig_button_hide(wmap_ui_zoom_button_info[i].button_handle);
+            else tig_button_show(wmap_ui_zoom_button_info[i].button_handle);
+        }
+        if(modern_map_buttons_hidden) {
+            tig_button_hide(wmap_ui_navigate_button_info.button_handle);
+            tig_button_hide(wmap_ui_travel_button_info.button_handle);
+        } else {
+            tig_button_show(wmap_ui_navigate_button_info.button_handle);
+            if(wmap_ui_mode!=WMAP_UI_MODE_CONTINENT && (wmap_ui_mode==WMAP_UI_MODE_TOWN || dword_66D880))
+                tig_button_show(wmap_ui_travel_button_info.button_handle);
+        }
+        wmap_ui_mode_info[wmap_ui_mode].refresh();return;
+    }
+    if(action>=4 && action<=7){wmap_ui_scroll((action-4)*2);return;}
+    TigMessage message={0};message.type=TIG_MESSAGE_BUTTON;message.data.button.state=TIG_BUTTON_STATE_RELEASED;
+    message.data.button.button_handle=action==1?wmap_ui_zoom_button_info[0].button_handle:
+        action==2?wmap_ui_zoom_button_info[1].button_handle:wmap_ui_travel_button_info.button_handle;
+    wmap_ui_message_filter(&message);
+}
+const char* modern_map_text(int number)
+{
+    MesFileEntry entry={.num=number};mes_get_msg(wmap_ui_worldmap_mes_file,&entry);return entry.str;
+}
+
+/* Native drag deltas use map pixels and the original viewport bounds. */
+void modern_map_pan(int dx,int dy)
+{
+    if(!wmap_ui_created || wmap_ui_state==WMAP_UI_STATE_MOVING)return;
+    WmapInfo* info=&wmap_ui_mode_info[wmap_ui_mode];
+    int x=info->field_34+dx,y=info->field_38+dy;
+    if(x<0)x=0;
+    if(x>info->field_60)x=info->field_60;
+    if(y<0)y=0;
+    if(y>info->field_64)y=info->field_64;
+    if(x==info->field_34 && y==info->field_38)return;
+    info->field_34=x;info->field_38=y;
+    if(info->refresh_rect)info->refresh_rect(&info->rect);
+}
+
+bool modern_map_local_state(ModernLocalMap* state)
+{
+    if(!wmap_ui_created || wmap_ui_mode!=WMAP_UI_MODE_TOWN)return false;
+    WmapInfo* info=&wmap_ui_mode_info[wmap_ui_mode];
+    WmapRoute* route=&wmap_ui_routes[WMAP_ROUTE_TYPE_TOWN];
+    *state=(ModernLocalMap){.width=info->map_width,.height=info->map_height,
+        .columns=info->num_hor_tiles,.rows=info->num_vert_tiles,
+        .count=route->length>6?6:route->length};
+    state->x[0]=info->field_3C.x;state->y[0]=info->field_3C.y;
+    for(int i=0;i<state->count;i++) {
+        state->x[i+1]=route->waypoints[i].coords.x;
+        state->y[i+1]=route->waypoints[i].coords.y;
+    }
+    return true;
+}
+
+void modern_map_local_mouse(int x,int y,int event,int radius)
+{
+    if(!wmap_ui_created || wmap_ui_mode!=WMAP_UI_MODE_TOWN
+        || wmap_ui_state!=WMAP_UI_STATE_NORMAL)return;
+    WmapInfo* info=&wmap_ui_mode_info[wmap_ui_mode];
+    if(x<0 || y<0 || x>=info->map_width || y>=info->map_height)return;
+    WmapCoords coords={x,y};
+    WmapRoute* route=&wmap_ui_routes[WMAP_ROUTE_TYPE_TOWN];
+    int selected=-1;
+    for(int i=route->length-1;i>=0;i--) {
+        int64_t dx=(int64_t)x-route->waypoints[i].coords.x,dy=(int64_t)y-route->waypoints[i].coords.y;
+        if(dx*dx+dy*dy<=(int64_t)radius*radius){selected=i;break;}
+    }
+    if(event==TIG_MESSAGE_MOUSE_LEFT_BUTTON_UP) {
+        if(selected>=0) {
+            dword_5C9AD8=selected;
+            sub_5649D0(route->waypoints[selected].field_4);
+        } else sub_5643E0(&coords);
+    } else if(event==TIG_MESSAGE_MOUSE_RIGHT_BUTTON_UP && selected>=0) {
+        sub_564840(selected);dword_5C9AD8=-1;
+    }
+}
+
+void modern_map_route_clear(void)
+{
+    if(!wmap_ui_created || wmap_ui_mode!=WMAP_UI_MODE_TOWN)return;
+    if(wmap_ui_state==WMAP_UI_STATE_MOVING)wmap_ui_state_set(WMAP_UI_STATE_NORMAL);
+    if(wmap_ui_state!=WMAP_UI_STATE_NORMAL)return;
+    wmap_ui_routes[WMAP_ROUTE_TYPE_TOWN].length=0;
+    dword_5C9AD8=-1;dword_65E968=0;
+    sub_5649C0();wmap_ui_mode_info[wmap_ui_mode].refresh();
+}
+
+void* modern_map_local_tile(int index)
+{
+    if(!wmap_ui_created || wmap_ui_mode!=WMAP_UI_MODE_TOWN)return NULL;
+    WmapInfo* info=&wmap_ui_mode_info[wmap_ui_mode];
+    if(index<0 || index>=info->num_tiles || !wmTileArtLock(index))return NULL;
+    return info->tiles[index].video_buffer;
+}
+
+void modern_map_local_tile_release(int index)
+{
+    wmTileArtUnlock(index);
+}
