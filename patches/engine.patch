+
+void tig_mouse_display_native(SDL_Renderer* renderer, float x, float y, float scale)
+{
+    if (!tig_mouse_active || (tig_mouse_state.flags & TIG_MOUSE_STATE_HIDDEN) != 0
+        || !tig_mouse_cursor_video_buffer) return;
+    if (tig_mouse_native_dirty || !tig_mouse_native_texture) {
+        TigVideoBufferData data;
+        if (tig_video_buffer_lock(tig_mouse_cursor_video_buffer) != TIG_OK) return;
+        if (tig_video_buffer_data(tig_mouse_cursor_video_buffer, &data) == TIG_OK) {
+            SDL_Surface* surface = SDL_CreateSurfaceFrom(data.width, data.height,
+                SDL_PIXELFORMAT_XRGB8888, data.pixels, data.pitch);
+            if (surface) {
+                SDL_SetSurfaceColorKey(surface, true, data.color_key);
+                SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer, surface);
+                if (texture) {
+                    SDL_DestroyTexture(tig_mouse_native_texture);
+                    tig_mouse_native_texture = texture;
+                    SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+                    tig_mouse_native_dirty = false;
+                }
+                SDL_DestroySurface(surface);
+            }
+        }
+        tig_video_buffer_unlock(tig_mouse_cursor_video_buffer);
+    }
+    if (tig_mouse_native_texture) {
+        SDL_FRect source = {0, 0, tig_mouse_state.frame.width, tig_mouse_state.frame.height};
+        SDL_FRect destination = {x - tig_mouse_state.offset_x * scale,
+            y - tig_mouse_state.offset_y * scale, source.w * scale, source.h * scale};
+        SDL_RenderTexture(renderer, tig_mouse_native_texture, &source, &destination);
+    }
+}
