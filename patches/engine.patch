+/* Optional native-resolution replacements, keyed to the original splash name.
+ * Keep the engine's rotation and fall back to its installed artwork. */
+static SDL_Texture* gamelib_splash_texture;
+static SDL_Texture* gamelib_splash_label;
+
+void gamelib_splash_clear(void)
+{
+    if(!gamelib_splash_texture)return;
+    tig_video_set_slide_overlay(NULL);
+    SDL_DestroyTexture(gamelib_splash_texture);
+    SDL_DestroyTexture(gamelib_splash_label);
+    gamelib_splash_texture=NULL;
+    gamelib_splash_label=NULL;
+}
+
+static void gamelib_draw_splash(SDL_Renderer* renderer)
+{
+    int width,height,old_width,old_height;
+    float image_width,image_height;
+    SDL_RendererLogicalPresentation old_mode;
+    SDL_GetRenderOutputSize(renderer,&width,&height);
+    SDL_GetTextureSize(gamelib_splash_texture,&image_width,&image_height);
+    SDL_GetRenderLogicalPresentation(renderer,&old_width,&old_height,&old_mode);
+    SDL_SetRenderLogicalPresentation(renderer,width,height,SDL_LOGICAL_PRESENTATION_DISABLED);
+    SDL_SetRenderDrawColor(renderer,0,0,0,255);
+    SDL_RenderFillRect(renderer,NULL);
+    float scale=(float)width/image_width;
+    if(scale*image_height>height)scale=(float)height/image_height;
+    SDL_FRect rect={(width-image_width*scale)/2,(height-image_height*scale)/2,
+        image_width*scale,image_height*scale};
+    SDL_RenderTexture(renderer,gamelib_splash_texture,NULL,&rect);
+    if(gamelib_splash_label) {
+        float w,h;SDL_GetTextureSize(gamelib_splash_label,&w,&h);
+        float label_scale=w>rect.w*0.8f?rect.w*0.8f/w:1;
+        SDL_FRect label={rect.x+rect.w-w*label_scale-rect.w*0.06f,
+            rect.y+rect.h*0.87f,w*label_scale,h*label_scale};
+        SDL_FRect shadow=label;shadow.x+=2;shadow.y+=2;
+        SDL_SetTextureColorMod(gamelib_splash_label,0,0,0);
+        SDL_RenderTexture(renderer,gamelib_splash_label,NULL,&shadow);
+        SDL_SetTextureColorMod(gamelib_splash_label,255,255,255);
+        SDL_RenderTexture(renderer,gamelib_splash_label,NULL,&label);
+    }
+    SDL_SetRenderLogicalPresentation(renderer,old_width,old_height,old_mode);
+}
+
+static bool gamelib_load_splash(const char* name)
+{
+    SDL_Renderer* renderer;
+    char path[TIG_MAX_PATH];
+    size_t length=strlen(name);
+    if(length<4 || tig_video_renderer_get(&renderer)!=TIG_OK)return false;
+    snprintf(path,sizeof(path),"modern-ui/splash/%.*s.png",(int)(length-4),name);
+    SDL_strlwr(path);
