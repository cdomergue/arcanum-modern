+/* Replace the logical framebuffer without changing the OS window or display mode. */
+int tig_video_resize_logical(int width, int height)
+{
+    if (!tig_video_initialized || width < 800 || height < 600 || width > 4096 || height > 4096)
+        return TIG_ERR_INVALID_PARAM;
+    SDL_Surface* surface = SDL_CreateSurface(width, height, SDL_PIXELFORMAT_XRGB8888);
+    SDL_Texture* texture = SDL_CreateTexture(tig_video_state.renderer, SDL_PIXELFORMAT_XRGB8888,
+        SDL_TEXTUREACCESS_STREAMING, width, height);
+    if (!surface || !texture) {
+        SDL_DestroySurface(surface); SDL_DestroyTexture(texture);
+        return TIG_ERR_GENERIC;
+    }
+    if (!SDL_SetRenderLogicalPresentation(tig_video_state.renderer, width, height, SDL_LOGICAL_PRESENTATION_LETTERBOX)) {
+        SDL_DestroySurface(surface); SDL_DestroyTexture(texture);
+        return TIG_ERR_GENERIC;
+    }
+    SDL_DestroySurface(tig_video_state.surface); SDL_DestroyTexture(tig_video_state.texture);
+    tig_video_state.surface = surface; tig_video_state.texture = texture;
+    stru_610388 = (TigRect){0, 0, width, height};
+    return TIG_OK;
+}
diff --git a/first_party/tig/src/window.c b/first_party/tig/src/window.c
--- a/first_party/tig/src/window.c
+++ b/first_party/tig/src/window.c
@@ -1804,3 +1804,33 @@
 
     return TIG_OK;
 }
+
+/* Keep the world handle and message filter stable while changing its raster size. */
+int tig_window_resize_world(tig_window_handle_t handle, int width, int height)
+{
+    if (!tig_window_initialized || handle == TIG_WINDOW_HANDLE_INVALID
+        || width < 800 || height < 600 || width > 4096 || height > 4096) return TIG_ERR_INVALID_PARAM;
+    int index = tig_window_handle_to_index(handle);
+    if (index < 0 || index >= TIG_WINDOW_MAX) return TIG_ERR_INVALID_PARAM;
+    TigWindow* win = &windows[index];
+    if (win->usage & TIG_WINDOW_USAGE_FREE || win->flags & TIG_WINDOW_TRANSPARENT) return TIG_ERR_INVALID_PARAM;
+    TigVideoBufferCreateInfo info = {0};
+    info.flags = TIG_VIDEO_BUFFER_CREATE_VIDEO_MEMORY;
+    info.width = width; info.height = height; info.background_color = win->background_color;
+    TigVideoBuffer* buffer;
+    int rc = tig_video_buffer_create(&info, &buffer);
+    if (rc != TIG_OK) return rc;
+    rc = tig_video_resize_logical(width, height);
+    if (rc != TIG_OK) {tig_video_buffer_destroy(buffer);return rc;}
+    tig_video_buffer_destroy(win->video_buffer); win->video_buffer = buffer;
+    win->frame.width = win->bounds.width = width;
+    win->frame.height = win->bounds.height = height;
+    tig_window_screen_rect = (TigRect){0, 0, width, height};
+    while (tig_window_dirty_rects) {
+        TigRectListNode* node = tig_window_dirty_rects;
+        tig_window_dirty_rects = node->next; tig_rect_node_destroy(node);
+    }
+    tig_mouse_resize_screen(width, height);
+    tig_window_invalidate_rect(NULL);
+    return TIG_OK;
+}
