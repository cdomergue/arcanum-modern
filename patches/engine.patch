+/* Read-only previews: never invoke an action, a script, or a random roll. */
+bool modern_combat_preview(ModernCombatPreview* p)
+{
+    memset(p, 0, sizeof(*p)); p->chance = -1; p->in_range = true;
+    p->actor = combat_input_actor();
+    if (!combat_turn_based_is_active() || !combat_input_ready(p->actor)) return false;
+    TigMouseState mouse; TargetDescriptor td;
+    if (tig_mouse_get_state(&mouse) != TIG_OK || !sub_5518C0(mouse.x, mouse.y)) return false;
+    if (!target_pick_at_screen_xy_ex(mouse.x, mouse.y, &td, TGT_OBJECT | TGT_OBJ_NO_T_WALL | TGT_TILE, intgame_fullscreen)) return false;
+    p->target = td.is_loc ? OBJ_HANDLE_NULL : td.obj;
+    if (p->target == p->actor && intgame_mode_get() == INTGAME_MODE_MAIN) return false;
+    if (p->target && intgame_mode_get() == INTGAME_MODE_MAIN && !tig_kb_get_modifier(SDL_KMOD_ALT)
+        && (player_is_local_pc_obj(p->target) || player_is_local_pc_obj(critter_pc_leader_get(p->target)))) return false;
+    p->location = td.is_loc ? td.loc : obj_field_int64_get(td.obj, OBJ_F_LOCATION);
+    int64_t from = obj_field_int64_get(p->actor, OBJ_F_LOCATION);
+    bool adjacent = false, needs_path = false;
+    p->step_cost = 2;
+    /* Match the command's run/walk choice, including NumLock/Ctrl for NPCs. */
+    bool run = p->target
+        ? !tig_kb_get_modifier(SDL_KMOD_SHIFT)
+            && (tig_kb_get_modifier(SDL_KMOD_CTRL) || !tig_kb_get_modifier(SDL_KMOD_NUM) || get_always_run(p->actor))
+        : (((tig_kb_get_modifier(SDL_KMOD_CTRL) || tig_kb_get_modifier(SDL_KMOD_NUM))
+                && !settings_get_value(&settings, ALWAYS_RUN_KEY))
+            || (combat_player_controls(p->actor) && get_always_run(p->actor)));
+    if (run && critter_encumbrance_level_get(p->actor) < ENCUMBRANCE_LEVEL_SIGNIFICANT
+        && critter_fatigue_current(p->actor) > 0) p->step_cost = 1;
+    if (intgame_mode_get() == INTGAME_MODE_SPELL) {
+        int spl = modern_spell_selected();
+        if (spl < 0 || spl >= SPELL_COUNT) return false;
+        p->kind = 2; p->cost = 4; p->radius = sub_4502B0(spl);
+        p->in_range = location_dist(from, p->location) <= magictech_get_range(spl);
+        /* LOS check only reads the invocation. The run/charge APIs are excluded. */
+        MagicTechInvocation invocation;
+        magictech_invocation_init(&invocation, p->actor, spl);
+        if (td.is_loc) invocation.target_loc = td.loc;
+        else sub_4440E0(td.obj, &invocation.target_obj);
+        p->blocked = !magictech_check_los(&invocation);
+        p->reachable = p->in_range && !p->blocked;
+    } else if (intgame_mode_get() == INTGAME_MODE_SKILL || intgame_mode_get() == INTGAME_MODE_ITEM) {
+        /* Skills and items have specific validation/costs: don't invent a quote. */
+        return false;
+    } else if (p->target && obj_type_is_critter(obj_field_int32_get(p->target, OBJ_F_TYPE)) && !critter_is_dead(p->target)) {
+        p->kind = 1; p->cost = combat_attack_cost(p->actor);
+        int64_t weapon = item_wield_get(p->actor, ITEM_INV_LOC_WEAPON);
+        int range = weapon ? item_weapon_range(weapon, p->actor) : 1;
+        needs_path = range <= 1 && location_dist(from, p->location) > 1;
+        adjacent = true;
+        p->in_range = range <= 1 || location_dist(from, p->location) <= range;
+        SkillInvocation si; skill_invocation_init(&si);
+        sub_4440E0(p->actor, &si.source); sub_4440E0(p->target, &si.target); sub_4440E0(weapon, &si.item);
+        si.skill = item_weapon_skill(weapon);
+        int effectiveness = IS_TECH_SKILL(si.skill) ? tech_skill_effectiveness(p->actor, GET_TECH_SKILL(si.skill), p->target)
+            : basic_skill_effectiveness(p->actor, GET_BASIC_SKILL(si.skill), p->target);
+        effectiveness -= skill_invocation_difficulty(&si);
+        if (weapon && si.skill != SKILL_THROWING) {
+            int penalty = sub_461620(weapon, p->actor, p->target);
+            if (penalty > 0) effectiveness -= effectiveness * penalty / 100;
+        }
+        p->blocked = (si.flags & SKILL_INVOCATION_BLOCKED_SHOT) != 0;
+        /* The current-position hit chance is only meaningful once in range. */
+        if (!needs_path) p->chance = effectiveness < 0 || !p->in_range || p->blocked ? 0 : effectiveness;
+        p->reachable = p->in_range && !p->blocked;
+    } else {
+        if (p->target) return false;
+        p->kind = 0; p->reachable = true; needs_path = from != p->location;
+    }
+    if (needs_path) {
+        AnimPath path;
+        p->reachable = anim_preview_path(p->actor, p->location, adjacent, &path);
+        if (p->reachable) {
+            p->path[p->count++] = from;
+            int64_t loc = from;
+            for (int i = 0; i < path.max && p->count < 201; i++) {
+                if (!location_in_dir(loc, path.rotations[i], &loc)) break;
+                p->path[p->count++] = loc;
+            }
+            p->cost += path.max * p->step_cost;
+        }
+    }
+    int ap = combat_action_points_get();
+    p->fatigue = p->cost > ap && ap > 0 && player_is_local_pc_obj(p->actor) && critter_fatigue_current(p->actor) > 1;
+    p->affordable = p->reachable && (p->cost <= ap || p->fatigue);
+    return true;
+}
