+
+/* Use the original point accounting, prerequisites and accepted-value checks. */
+const char* modern_charedit_text(int number)
+{
+    MesFileEntry entry = { 0 };
+    entry.num = number;
+    mes_get_msg(charedit_mes_file, &entry);
+    return entry.str;
+}
+
+void modern_charedit_adjust(int category, int index, int direction)
+{
+    if (!charedit_is_created() || charedit_obj != player_get_local_pc_obj()) return;
+    TigMessage message = { 0 };
+    message.type = TIG_MESSAGE_BUTTON;
+    message.data.button.state = TIG_BUTTON_STATE_PRESSED;
+    if (category == 0 && index >= 0 && index < 10) {
+        message.data.button.button_handle = direction > 0
+            ? stru_5C7F88[index].button_handle : stru_5C8028[index].button_handle;
+        charedit_window_message_filter(&message);
+    } else if (category == 1 && index >= 0 && index < SKILL_COUNT) {
+        message.data.button.button_handle = direction > 0
+            ? charedit_skills_plus_buttons[index].button_handle : charedit_skills_minus_buttons[index].button_handle;
+        charedit_skills_win_message_filter(&message);
+    } else if (category == 2 && index >= 0 && index < TECH_COUNT) {
+        /* Classic +/- buttons are created only when their panel is refreshed. */
+        int degree = tech_degree_get(charedit_obj, index);
+        if (direction > 0 && degree < DEGREE_COUNT - 1) tech_ui_inc_degree(charedit_obj, index);
+        else if (direction < 0 && degree > 0) tech_ui_dec_degree(charedit_obj, index);
+    } else if (category == 3 && index >= 0 && index < COLLEGE_COUNT) {
+        int level = spell_college_level_get(charedit_obj, index);
+        if (direction > 0 && level < 5) spell_ui_add(charedit_obj, 5 * index + level);
+        else if (direction < 0 && level > dword_64D364[index])
+            spell_ui_remove(charedit_obj, 5 * index + level - 1);
+    }
+    charedit_refresh();
+}
+
+
+int64_t modern_charedit_object(void) { return charedit_created ? charedit_obj : OBJ_HANDLE_NULL; }
+bool modern_charedit_editable(void) { return charedit_created && charedit_mode!=CHAREDIT_MODE_PASSIVE; }
