+/* Resize all world subsystems together; the native UI uses physical pixels. */
+bool modern_world_resize(int width, int height, float anchor_x, float anchor_y)
+{
+    TigWindowData data;
+    if (tig_window_data(dword_64C52C, &data) != TIG_OK) return false;
+    int old_width = data.rect.width, old_height = data.rect.height;
+    if (width == old_width && height == old_height) return true;
+    if (tig_window_resize_world(dword_64C52C, width, height) != TIG_OK) return false;
+    GameResizeInfo resize = {0};
+    resize.window_handle = dword_64C52C;
+    resize.window_rect = resize.content_rect = (TigRect){0, 0, width, height};
+    gamelib_resize(&resize);
+    /* Interface-layout callbacks rebuild classic buttons at new HRP offsets.
+     * Only the viewport consumers must follow a camera zoom. */
+    target_resize(&resize);
+    iso_resize(&resize);
+    combat_ui_resize(&resize);
+    follower_ui_resize(&resize);
+    location_origin_scroll((int)((width-old_width)*anchor_x), (int)((height-old_height)*anchor_y));
+    object_hover_obj_set(OBJ_HANDLE_NULL);
+    iso_invalidate_rect(&resize.content_rect);
+    SDL_Renderer* renderer;
+    if (tig_video_renderer_get(&renderer) == TIG_OK) {
+        float x,y,rx,ry; SDL_GetMouseState(&x,&y);
+        if (SDL_RenderCoordinatesFromWindow(renderer,x,y,&rx,&ry)) tig_mouse_set_position((int)rx,(int)ry);
+    }
+    return true;
+}
