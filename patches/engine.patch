+static void combat_report_attack(CombatContext* combat, int chance, int roll,
+    int armor_penalty, int dodge_chance, int dodge_roll, bool dodged)
+{
+    if (!combat_turn_based_is_active()) return;
+    MesFileEntry outcome;
+    mes_file_handle_t messages = MES_FILE_HANDLE_INVALID;
+    bool hit = (combat->flags & CF_HIT) != 0;
+    bool critical = (combat->flags & CF_CRITICAL) != 0;
+    char text[1024];
+    if (critical || (dodged && !hit)) {
+        outcome.num = critical ? (hit ? 12 : 2) : 11;
+        mes_get_msg(combat_mes_file, &outcome);
+    } else {
+        if (!mes_load("mes\\skill_ui.mes", &messages)) return;
+        outcome.num = hit ? 500 : 501;
+        mes_get_msg(messages, &outcome);
+    }
+    snprintf(text, sizeof(text), "%s", outcome.str);
+    if (roll > 0) {
+        int percent = chance < 0 ? 0 : chance > 100 ? 100 : chance;
+        snprintf(text + strlen(text), sizeof(text) - strlen(text), " | %s %d%% (%d %s %d)",
+            modern_intgame_text(20), percent, roll, roll <= chance ? "<=" : ">", chance);
+    }
+    if (armor_penalty > 0) {
+        snprintf(text + strlen(text), sizeof(text) - strlen(text), " | %s %d (-%d)",
+            modern_intgame_text(70), object_get_ac(combat->target_obj, false), armor_penalty);
+    }
+    if (dodge_roll > 0) {
+        MesFileEntry dodge = { .num = 11 };
+        mes_get_msg(combat_mes_file, &dodge);
+        snprintf(text + strlen(text), sizeof(text) - strlen(text), " | %s %s (%d %s %d)",
+            dodge.str, dodged ? "+" : "-", dodge_roll, dodge_roll <= dodge_chance ? "<=" : ">", dodge_chance);
+    }
+    modern_combat_event(combat->attacker_obj, combat->target_obj, text);
+    if (messages != MES_FILE_HANDLE_INVALID) mes_unload(messages);
+}
