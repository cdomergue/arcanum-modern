+/* Expose installed text; the modern UI owns wrapping, never document contents. */
+int modern_written_kind(void)
+{
+    return written_ui_created ? written_ui_type : -1;
+}
+const char* modern_written_text(void)
+{
+    int type=modern_written_kind();
+    return type==WRITTEN_TYPE_NOTE || type==WRITTEN_TYPE_BOOK || type==WRITTEN_TYPE_NEWSPAPER
+        || type==WRITTEN_TYPE_TELEGRAM || type==WRITTEN_TYPE_PLAQUE ? written_ui_text : NULL;
+}
+bool modern_written_is_book(void)
+{
+    return modern_written_kind()==WRITTEN_TYPE_BOOK;
+}
+const char* modern_written_heading(int index)
+{
+    if(modern_written_kind()!=WRITTEN_TYPE_NEWSPAPER || index<0 || index>3)return "";
+    const int ids[]={written_ui_is_vendigroth_times?4:1,written_ui_is_vendigroth_times?5:3,2,0};
+    MesFileEntry entry={0};entry.num=ids[index];
+    return mes_search(written_ui_mes_files[WRITTEN_MES_NEWSPAPER],&entry)?entry.str:"";
+}
+int modern_written_paragraph_count(void)
+{
+    if(!modern_written_text())return 0;
+    if(written_ui_type==WRITTEN_TYPE_NEWSPAPER)return TEN+modern_newspaper_filler_count;
+    if(written_ui_type==WRITTEN_TYPE_TELEGRAM)return 13;
+    return TEN;
+}
+const char* modern_written_book_paragraph(int index,bool* centered,int* font)
+{
+    if(index<0 || index>=modern_written_paragraph_count())return NULL;
+    MesFileEntry entry={0};entry.num=written_ui_num+index;
+    *centered=false;*font=0;
+    if(written_ui_type==WRITTEN_TYPE_NEWSPAPER && index>=TEN)entry.num=modern_newspaper_fillers[index-TEN];
+    if(written_ui_type==WRITTEN_TYPE_TELEGRAM){
+        if(index==11)return written_ui_text;
+        entry.num=index==12?1011:written_ui_telegram_elements[index].message_num;
+        *centered=index<11 && written_ui_telegram_elements[index].alignment==WRITTEN_TEXT_ALIGNMENT_CENTER;
+        return mes_search(written_ui_mes_file,&entry)?entry.str:NULL;
+    }
+    if(!mes_search(written_ui_mes_file,&entry))return NULL;
+    int alignment;char* text;
+    written_ui_parse(entry.str,font,&alignment,&text);
+    *centered=alignment!=0;
+    return text;
+}
+void modern_written_sync(bool modern)
+{
+    if(!modern_written_text())return;
+    bool hidden=tig_window_is_hidden(written_ui_window);
+    if(modern && !hidden)tig_window_hide(written_ui_window);
+    else if(!modern && hidden)tig_window_show(written_ui_window);
+}
